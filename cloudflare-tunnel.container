[Container]
Image=docker.io/cloudflare/cloudflared:2026.9.1@sha256:b269e8abd07a5bf6f3f4be65d5050b2174eca89c56a0241a8ff32a16aec454e4
ContainerName=cloudflare-tunnel

Network=cloudflare-tunnel.network

Secret=cloudflare_tunnel_token,target=tunnel_token,uid=65532,gid=65532,mode=0400

Environment=TUNNEL_METRICS=127.0.0.1:60123

ReadOnly=true
ReadOnlyTmpfs=false

User=65532
Group=65532
UserNS=auto
NoNewPrivileges=true
DropCapability=all

Exec=tunnel --no-autoupdate run --token-file /run/secrets/tunnel_token

HealthStartupCmd=cloudflared tunnel ready
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthCmd=cloudflared tunnel ready
HealthInterval=30s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=256M
PidsLimit=30

[Service]
CPUQuota=100%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
